# Supabase public client values. Admin writes are protected by session + RLS.
# Never add SUPABASE_SERVICE_ROLE_KEY to this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public site URL for canonical metadata / OG tags. Set to the real domain in CI (Phase 3).
VITE_SITE_URL=https://haengun.example.com
# Naver Cloud Maps client id — OPTIONAL. Saving still works when the map is unavailable.
VITE_NAVER_MAP_CLIENT_ID=
# Search engine ownership verification codes — OPTIONAL (see docs/SETUP.md §5).
VITE_NAVER_SITE_VERIFICATION=
VITE_GOOGLE_SITE_VERIFICATION=
