# Supabase public client values. Admin writes are protected by session + RLS.
# Never add SUPABASE_SERVICE_ROLE_KEY to this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public site URL for canonical metadata and password-reset redirects.
NEXT_PUBLIC_SITE_URL=https://haengun.example.com
# Naver Cloud Maps client id — OPTIONAL. Saving still works when the map is unavailable.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Search engine ownership verification codes — OPTIONAL, fill in once you register
# the site (see docs/SETUP.md §5). Leave empty until then; no code changes needed.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
